{
  "name": "consign",
  "version": "0.1.0",
  "description": "A consignment marketplace for ERC-721 tokens, written to argue about how a sale should be settled",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "lint": "solhint 'contracts/**/*.sol'",
    "type-check": "tsc --noEmit",
    "check": "pnpm lint && pnpm type-check && pnpm test",
    "mutate": "node scripts/mutate.ts",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy"
  },
  "keywords": [
    "solidity",
    "erc721",
    "erc2981",
    "marketplace",
    "hardhat",
    "polygon"
  ],
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^26.2.0",
    "hardhat": "^3.12.0",
    "solhint": "^6.2.3",
    "typescript": "^7.0.2",
    "viem": "^2.55.13"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
